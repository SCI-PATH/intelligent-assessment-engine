# Normalize text files to LF in the repo (stops LF→CRLF warnings on Windows).
* text=auto eol=lf

# Explicit source types
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.jinja text eol=lf
*.env text eol=lf
*.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Keep Windows scripts CRLF if ever needed (none required today)

# Binaries — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.gz binary
*.whl binary
*.pyc binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
