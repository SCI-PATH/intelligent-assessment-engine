# LLM provider: set models.llm_provider in src/iae/config/app.yaml (openai | groq).
# API keys only — never commit real values:
OPENAI_API_KEY=replace_me
GROQ_API_KEY=replace_me

API_BASE_URL=http://localhost:8004

# ---------------------------------------------------------------------------
# PostgreSQL — swap ONLY this one line to move between local and Neon
# All ORM models use schema ``question_engine`` (isolated on shared Neon).
# ---------------------------------------------------------------------------
# Local:
DATABASE_URL=postgresql+psycopg://iae:iae@localhost:5432/iae
# Neon (shared team instance — neondb / question_engine):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# After swapping, verify:
#   python -m scripts.db.test_connection
#   python -m scripts.init_postgres

CHROMA_PERSIST_DIR=data/chroma_db
SKILLS_XLSX_PATH=data/skills/Skill-Heirarchies-G6-G9-Full-Chapters.xlsx

# Peer microservice URLs are HARDCODED in src/iae/config/peers.py
# Deployed: C1 http://3.6.20.31:8000 · C3 http://3.6.20.31:8002 · C4 http://52.66.167.213:8003
# Set PEER_HTTP_LIVE = True there when peers are reachable.

HTTP_CLIENT_TIMEOUT_S=3.0
DEBUG_AGENT_LOG=false
# Print request/response JSON in the uvicorn terminal (set false to quiet logs)
LOG_HTTP_PAYLOADS=true
